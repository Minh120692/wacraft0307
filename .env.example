# Contact form (components/contact-overlay.js) posts from the browser to Web3Forms.
# The access key is public by design: it ships in the JS bundle and only lets a sender
# mail the one address it was registered to. Next inlines it at BUILD time, so it must
# be set when `npm run build` runs; changing it later needs a rebuild. Left empty, the
# popup shows the published email address instead of the form.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# The SMTP lines below serve only server/contact-route.js (the old nodemailer route),
# which the static export does not use.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sunflora92612@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM_EMAIL=sunflora92612@gmail.com
SMTP_FROM_NAME=WA+CRAFT Contact
CONTACT_TO_EMAIL=sunflora92612@gmail.com
